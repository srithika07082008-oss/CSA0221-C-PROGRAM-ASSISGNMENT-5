#include <stdio.h>
#include <string.h>

typedef struct {
    int group_code;
    int units;
} Stock;

typedef struct {
    int id;
    char name[40];
    char group[4];
    int age;
} Donor;

int update_units(FILE *fp, int index, int units)
{
    if (fp == NULL || index < 0)
        return 0;

    Stock record;
    long offset = (long)index * (long)sizeof record;

    if (fseek(fp, offset, SEEK_SET) != 0)
        return 0;

    if (fread(&record, sizeof record, 1, fp) != 1)
        return 0;

    record.units = units;

    if (fseek(fp, offset, SEEK_SET) != 0)
        return 0;

    if (fwrite(&record, sizeof record, 1, fp) != 1)
        return 0;

    return fflush(fp) == 0;
}

int save_donors_text(const char *filename,
                     const Donor donors[], size_t count)
{
    FILE *fp = fopen(filename, "w");
    if (fp == NULL) {
        perror(filename);
        return 0;
    }

    for (size_t i = 0; i < count; ++i) {
        if (fprintf(fp, "%d|%s|%s|%d\n",
                    donors[i].id, donors[i].name,
                    donors[i].group, donors[i].age) < 0) {
            perror("fprintf");
            fclose(fp);
            return 0;
        }
    }

    if (fclose(fp) != 0) {
        perror("fclose");
        return 0;
    }

    return 1;
}

int main(void)
{
    FILE *fp = tmpfile();
    if (fp == NULL) {
        perror("tmpfile");
        return 1;
    }

    Stock initial[5] = {
        {1, 40}, {2, 25}, {3, 12}, {4, 8}, {5, 30}
    };

    if (fwrite(initial, sizeof initial[0], 5, fp) != 5) {
        perror("fwrite");
        fclose(fp);
        return 1;
    }

    printf("update record 3: %s\n",
           update_units(fp, 3, 20) ? "done" : "failed");

    printf("update record 9: %s\n",
           update_units(fp, 9, 20) ? "done" : "failed");

    rewind(fp);

    Stock record;
    while (fread(&record, sizeof record, 1, fp) == 1)
        printf("%d:%d ", record.group_code, record.units);
    putchar('\n');

    fclose(fp);
    return 0;
}
