#include <stdio.h>
#include <string.h>
#include <stdlib.h>

typedef struct {
    char group[4];
    int units;
} Stock;

Stock *find_lowest_stock(Stock stock[], size_t n)
{
    if (stock == NULL || n == 0)
        return NULL;

    size_t lowest = 0;

    for (size_t i = 1; i < n; ++i) {
        if (stock[i].units < stock[lowest].units)
            lowest = i;
    }

    return &stock[lowest];
}

int main(int argc, char *argv[])
{
    Stock stock[] = {
        {"O+", 40}, {"O-", 25}, {"A+", 12}, {"A-", 8},
        {"B+", 30}, {"B-", 5}, {"AB+", 22}, {"AB-", 16}
    };
    size_t n = sizeof stock / sizeof stock[0];

    if (argc == 3 && strcmp(argv[1], "find") == 0) {
        for (size_t i = 0; i < n; ++i) {
            if (strcmp(stock[i].group, argv[2]) == 0) {
                printf("%s stock: %d units\n",
                       stock[i].group, stock[i].units);
                return 0;
            }
        }

        fprintf(stderr, "Unknown blood group: %s\n", argv[2]);
        return 2;
    }

    if (argc == 4 && strcmp(argv[1], "issue") == 0) {
        char *end = NULL;
        long amount = strtol(argv[3], &end, 10);

        if (end == argv[3] || *end != '\0' || amount <= 0) {
            fprintf(stderr, "Quantity must be a positive integer.\n");
            return 2;
        }

        for (size_t i = 0; i < n; ++i) {
            if (strcmp(stock[i].group, argv[2]) == 0) {
                if (amount > stock[i].units) {
                    fprintf(stderr, "Insufficient stock.\n");
                    return 1;
                }

                stock[i].units -= (int)amount;
                printf("Issued %ld units of %s; remaining=%d\n",
                       amount, argv[2], stock[i].units);
                return 0;
            }
        }

        fprintf(stderr, "Unknown blood group: %s\n", argv[2]);
        return 2;
    }

    Stock *lowest = find_lowest_stock(stock, n);
    if (lowest != NULL)
        printf("Lowest: %s with %d units\n",
               lowest->group, lowest->units);

    fprintf(stderr,
            "Usage: %s find GROUP | issue GROUP QUANTITY\n", argv[0]);
    return 2;
}
