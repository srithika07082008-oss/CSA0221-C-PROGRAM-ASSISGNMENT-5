#include <stdio.h>
#include <limits.h>

long long calls;

long long power_linear(long long base, int exp)
{
    ++calls;
    if (exp == 0)
        return 1;

    return base * power_linear(base, exp - 1);
}

long long power_fast(long long base, int exp)
{
    ++calls;

    if (exp == 0)
        return 1;

    long long half = power_fast(base, exp / 2);

    if (exp % 2 == 0)
        return half * half;

    return base * half * half;
}

long long power_iterative(long long base, unsigned int exp)
{
    long long result = 1;

    while (exp > 0) {
        if (exp % 2U == 1U)
            result *= base;

        exp /= 2U;

        if (exp > 0)
            base *= base;
    }

    return result;
}

int digital_root(long long n)
{
    if (n < 0) {
        if (n == LLONG_MIN)
            return -1; /* Reject this edge case in this simple example. */
        n = -n;
    }

    if (n < 10)
        return (int)n;

    int sum = 0;
    while (n > 0) {
        sum += (int)(n % 10);
        n /= 10;
    }

    return digital_root(sum);
}

int main(void)
{
    calls = 0;
    printf("2^30 linear = %lld, calls = %lld\n",
           power_linear(2, 30), calls);

    calls = 0;
    long long fast_result = power_fast(2, 30);
    printf("2^30 fast = %lld, calls = %lld\n", fast_result, calls);

    printf("2^13 iterative = %lld\n", power_iterative(2, 13));
    printf("digital root of 9875 = %d\n", digital_root(9875));
    printf("digital root of 0 = %d\n", digital_root(0));
    printf("digital root of 1 = %d\n", digital_root(1));

    return 0;
}
